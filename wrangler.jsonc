{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "commonplace",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "commonplace",
      "database_id": "54d62175-f8ff-4373-bd79-419d261cf411"
    }
  ]
}
